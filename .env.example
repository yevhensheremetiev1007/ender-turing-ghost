# Public name of the blog. Caddy requests a certificate for this host.
DOMAIN=blog.example.com
ACME_EMAIL=you@example.com

# One OpenSSH public key. This is the only account that can SSH.
SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@laptop

# Optional. 16-128 letters and digits. Generated into the bundle when empty.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Account created on the VPS. SSH accepts this user only.
ADMIN_USER=ghostadmin

# none, cloudflare, tailscale, or wireguard.
TUNNEL=none

# Cloudflare Tunnel token. Publish a TCP hostname aimed at localhost:22.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional. Defaults to ssh.$DOMAIN
CLOUDFLARE_SSH_HOSTNAME=

# Tailscale auth key (tskey-auth-...).
TAILSCALE_AUTH_KEY=
# Optional single DNS label. Defaults to the domain with dots replaced by hyphens.
TAILSCALE_HOSTNAME=

# Optional host:port. Defaults to $DOMAIN:51820. Open this UDP port in the cloud firewall.
WIREGUARD_ENDPOINT=
